PROJECT_NAME="College Placement Portal"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production-environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MySQL default with SQLite dev fallback)
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD="password"
MYSQL_DB="placement_portal"

# AWS S3 Resume Storage Configuration
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME="college-placement-resumes"
USE_MOCK_S3="True"
